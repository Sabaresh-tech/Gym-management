# Copy this file to .env and fill in real values. Never commit the real .env.

# Local MongoDB (default if you have `mongod` running locally):
MONGO_URI=mongodb://127.0.0.1:27017/gym_management

# Or use MongoDB Atlas instead — replace MONGO_URI above with something like:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gym_management?retryWrites=true&w=majority

PORT=5000

# Comma-separated list of origins allowed to call this API from the browser.
# The Vite dev server for the existing frontend runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# "development" enables verbose morgan request logs and error stack traces
# in JSON responses; use "production" to quiet both for a real deployment.
NODE_ENV=development

# Experiment No. 5 — rate limiting (applied to all /api/* routes).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Experiment No. 6 — JWT authentication. Generate a long random string for
# JWT_SECRET (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# and put the REAL value only in backend/.env, never here or in git.
JWT_SECRET=
JWT_EXPIRES_IN=1d
